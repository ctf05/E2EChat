# =============================================================================
# E2EChat Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Run ./scripts/setup.sh to auto-generate secrets and build config files.
# =============================================================================

# --- Domain Configuration ---------------------------------------------------
# Subdomain for the Matrix homeserver (becomes your server_name).
# Matrix IDs will be @user:chat.example.com
# WARNING: Cannot be changed after first run without wiping the database.
MATRIX_DOMAIN=chat.example.com

# Subdomain for LiveKit voice/video and JWT auth service
LIVEKIT_DOMAIN=call.example.com

# Subdomain for Element Web (browser-based client)
ELEMENT_DOMAIN=app.example.com

# --- Secrets (auto-generated by setup.sh) ------------------------------------
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
REGISTRATION_TOKEN=

# --- Optional ----------------------------------------------------------------
# Email for Let's Encrypt certificate expiry notifications
ACME_EMAIL=

# Continuwuity log level: debug, info, warn, error
LOG_LEVEL=info

# Maximum file upload size in bytes (default: 20MB)
MAX_UPLOAD_SIZE=20971520
